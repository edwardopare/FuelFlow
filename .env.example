POSTGRES_DB=fuelflow
POSTGRES_USER=fuelflow
POSTGRES_PASSWORD=fuelflow-local
DEMO_ADMIN_PASSWORD=ChangeMeNow1!
DEMO_VENDOR_PASSWORD=ChangeMeNow1!

# Local email delivery defaults to the Laravel log. To send through Gmail,
# change MAIL_MAILER to smtp, use smtp.gmail.com:587, set MAIL_USERNAME and
# MAIL_FROM_ADDRESS to the Gmail address, and use a Google App Password below.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@fuelflow.local
MAIL_FROM_NAME="FuelFlow FSMS"
