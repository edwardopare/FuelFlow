COMPOSE_PROJECT_NAME=fuelflow-production
IMAGE_TAG=latest
APP_PORT=8080
APP_BIND_ADDRESS=127.0.0.1

# Generate this value; never deploy the placeholder.
APP_KEY=base64:REPLACE_WITH_A_GENERATED_32_BYTE_KEY
APP_URL=https://fuel.example.com
FRONTEND_URL=https://fuel.example.com
CORS_ALLOWED_ORIGINS=https://fuel.example.com
SANCTUM_STATEFUL_DOMAINS=fuel.example.com
SESSION_DOMAIN=fuel.example.com
SESSION_LIFETIME=30
VENDOR_SESSION_LIFETIME=30
API_RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=warning

POSTGRES_DB=fuelflow
POSTGRES_USER=fuelflow_app
# Paste the complete managed PostgreSQL connection string here when using Neon.
DB_URL='postgresql://USER:PASSWORD@YOUR-NEON-HOST/DATABASE?sslmode=require'
POSTGRES_PASSWORD_SECRET_FILE=./secrets/postgres_password.txt
DB_SSLMODE=require
REDIS_PASSWORD_SECRET_FILE=./secrets/redis_password.txt
MAIL_PASSWORD_SECRET_FILE=./secrets/mail_password.txt

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-me
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=FuelFlow FSMS
